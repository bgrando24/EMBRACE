MYSQL_DATABASE=imdb
MYSQL_ROOT_PASSWORD= # root password
MYSQL_USER=embrace
MYSQL_PASSWORD= # embrace user password
MYSQL_HOST= # mySQL server host, as seen by the Python scripts (e.g. 127.0.0.1 on the docker host, or through an SSH tunnel)
MYSQL_PORT=3306 # mySQL server port
IMDB_DATA_DIR= # absolute path to the directory holding the IMDB .tsv files (mounted read-only at /import)
# MYSQL_BIND_ADDRESS=127.0.0.1 # optional: host address the container port is published on (default localhost only)

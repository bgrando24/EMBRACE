# Daily EMBRACE picks: per-user recommendation playlists in Emby + a Discord preview (see docs/workflows/cron_jobs.md).
# Runs straight after embrace-refresh.service, whether or not the refresh succeeded (yesterday's data still makes
# fair picks): `systemctl --user enable embrace-picks.service` links it to the refresh via [Install] below.
[Unit]
Description=EMBRACE: daily recommendation playlists
Wants=network-online.target
After=network-online.target embrace-refresh.service

[Service]
Type=oneshot
WorkingDirectory=%h/src/EMBRACE
Environment=PYTHONPATH=%h/src/EMBRACE/src
ExecStart=%h/src/EMBRACE/venv/bin/python scripts/picks/daily_picks.py
Nice=10

[Install]
WantedBy=embrace-refresh.service
